# Stage 1: build the SPA
FROM node:26-alpine AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json* ./
RUN npm ci || npm install
COPY ui/ ./
RUN npm run build

# Stage 2: build the Go binary with the embedded SPA
FROM golang:1.26-alpine AS build
# Set by release.yaml to the semver it just computed, so the running container can
# report what it is (startup log + /api/health). Defaults to "dev" for local builds.
ARG BACKEND_VERSION=dev
WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY backend/ ./backend/
COPY --from=ui /backend/web/dist ./backend/web/dist
RUN cd backend && CGO_ENABLED=0 go build \
	-ldflags="-s -w -X github.com/trick77/music/internal/buildinfo.Version=${BACKEND_VERSION}" \
	-o /music ./cmd/music

# Stage 3: runtime
FROM alpine:3.24
# CA certs for outbound HTTPS (OIDC discovery, BFL image API); tzdata for local time.
RUN apk add --no-cache ca-certificates tzdata
# Create the data dir owned by the app user so a fresh named volume (dev compose)
# inherits uid 10001 and the non-root process can write music.db + the media root.
# Prod bind-mounts ./data over this and runs with its own user, so ownership here
# is dev-only and harmless there.
RUN adduser -D -u 10001 app && mkdir -p /data && chown app:app /data
USER app
COPY --from=build /music /music
EXPOSE 8080
ENTRYPOINT ["/music"]
